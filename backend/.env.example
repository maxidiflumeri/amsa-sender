# AMSA Sender — Backend. Copiá a .env y completá. NO commitear el .env real.
NODE_ENV=development
PORT=3001
FRONT_BASE_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:3001
DATABASE_URL=mysql://usuario:clave@localhost:3306/whatsapp_automation
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=cambiar
JWT_EXPIRES_IN=1d

# --- Notificaciones push (PWA) ---
# Generá el par de claves UNA sola vez con:  npx web-push generate-vapid-keys
# La pública se la damos al navegador; la privada NUNCA sale del servidor.
# Si cambiás las claves, todas las suscripciones existentes dejan de funcionar
# (los usuarios tienen que volver a activar las notificaciones).
# Si falta alguna, el backend arranca igual y el push queda deshabilitado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del emisor, con mailto: o https:
VAPID_SUBJECT=mailto:soporte@anamayasa.com
